generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id    String @id @default(uuid(7)) @db.Uuid
  name  String
  users User[]

  @@map("province")
}

enum UserStatus {
  /// Registered, email not verified yet.
  INACTIVE
  ACTIVE

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  /// Stored lowercased, so uniqueness is case-insensitive.
  email        String     @unique
  /// E.164 format, e.g. +243812345678.
  phone        String     @unique
  /// argon2id hash. Never selected outside authentication code.
  passwordHash String     @map("password_hash")
  /// Province the user lives in. A province with users cannot be deleted.
  provinceId   String     @map("province_id") @db.Uuid
  province     Province   @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  /// Free text, entered by the user.
  city         String
  status       UserStatus @default(INACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([provinceId])
  @@map("users")
}
