# development | test | production (default development)
NODE_ENV=development
PORT=8000

# Optional: fatal | error | warn | info | debug | trace | silent
# (default info in production, debug otherwise)
LOG_LEVEL=debug

# Prisma Postgres connection string (console.prisma.io)
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=verify-full

# Use rediss:// (TLS) outside local development
REDIS_URL=rediss://default:password@host:6379

# Optional: TTL of the province list cache, in seconds (default 300)
PROVINCES_CACHE_TTL_SECONDS=300

# Resend (resend.com/api-keys). A sending-only key is enough.
RESEND_API_KEY=re_xxxxxxxxx
# Sender; its domain must be verified in Resend. onboarding@resend.dev only
# delivers to the Resend account owner's address.
MAIL_FROM="BrightPath <noreply@example.com>"

# Optional: Swagger UI at /docs (default true, false in production)
SWAGGER_ENABLED=true

# Origins allowed to call the API from a browser (CORS), comma-separated.
# No wildcard: cookies are sent with credentials.
CORS_ORIGINS=http://localhost:3000

# Auth JWTs. Two distinct secrets of at least 32 characters, e.g. from
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Optional: token lifetimes in seconds (default 900 = 15 min, 604800 = 7 days)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional: cookie domain (e.g. .brightpath.cd to share with subdomains).
# Leave unset for host-only cookies, e.g. in local development.
# Cookies are SameSite=Strict: the frontend must be on the same site as the
# API (e.g. app.brightpath.cd and api.brightpath.cd), or they are never sent.
# COOKIE_DOMAIN=
