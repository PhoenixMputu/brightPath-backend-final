PORT=8000

# Prisma Postgres connection string (console.prisma.io)
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=verify-full

# Use rediss:// (TLS) outside local development
REDIS_URL=rediss://default:password@host:6379

# Optional: TTL of the province list cache, in seconds (default 300)
PROVINCES_CACHE_TTL_SECONDS=300

# Resend (resend.com/api-keys). A sending-only key is enough.
RESEND_API_KEY=re_xxxxxxxxx
# Sender; its domain must be verified in Resend. onboarding@resend.dev only
# delivers to the Resend account owner's address.
MAIL_FROM="BrightPath <noreply@example.com>"
